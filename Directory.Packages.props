<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <!-- Latest preview from the Feedz feed: includes the compiled Oniguruma kernels (gregsex PR #25). -->
    <PackageVersion Include="GregsEx" Version="0.1.0-preview.56" />
    <PackageVersion Include="Meziantou.Polyfill" Version="1.0.166" />
    <!-- Pinned to the Roslyn shipped with the base .NET 10.0.100 SDK so the generator does not force a newer SDK. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageVersion Include="System.CommandLine" Version="2.0.13" />
    <PackageVersion Include="TextMateSharp" Version="2.0.4" />
    <PackageVersion Include="TextMateSharp.Grammars" Version="2.0.4" />
    <PackageVersion Include="TextMateLib" Version="0.2.1" />
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.2" />
  </ItemGroup>
</Project>
