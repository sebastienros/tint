<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <!-- 0.7.0 attempts a scanner's compiled patterns (kernels, tier 2) inside that walk too, instead of searching
         them whole, so every scanner searches the line buffer;
         0.6.0 walks an Oniguruma scanner's starts once for all its patterns (ONIG_REGSET_POSITION_LEAD), so a span
         search costs what a cached string-backed one did and the tokenizer searches its reused line buffer; it also
         jumps to the first branch an alternation can start with and keeps the failure memo outside subexpression
         calls, look-arounds and atomic groups;
         0.5.8 indexes the multi-code-point case folds that parsing ignore-case patterns looks up (TextMate keyword rules);
         0.5.7 skips interpreter work its start units rule out and shares a scanner's required-text lookups;
         0.5.6 stops an Oniguruma scanner's later patterns at the best start found so far (ONIG_REGSET_REGEX_LEAD);
         0.5.5 compiles the Oniguruma scanner search and the interpreter's search, attempt and helpers fully optimized
         on first call (docs/design.md section 6.2); 0.5.4 fixes compiling TextMate patterns with subexpression calls on .NET Framework (the netstandard2.0 target);
         0.5.3 makes kernel planning (which binding a generated kernel repeats to check its fingerprint) as cheap as in
         0.5.1 again; 0.5.2 added kernels for patterns with subexpression calls (the C# grammar's declarations) and the
         interpreter's branch skipping and possessive runs to every kernel; 0.5.1 shipped the compiled Oniguruma kernels,
         the KernelSource façade and OnigurumaCompileOptions.TextMate. Previews (0.1.0-preview.N) come from the Feedz
         feed in nuget.config. -->
    <PackageVersion Include="GregsEx" Version="0.7.0" />
    <PackageVersion Include="Meziantou.Polyfill" Version="1.0.166" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" />
    <!-- Pinned to the Roslyn shipped with the base .NET 10.0.100 SDK so the generator does not force a newer SDK. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <!-- Tracks the public surface of the shipped packages in PublicAPI.*.txt (RS0016/RS0017). 4.x runs on any SDK 10 compiler. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="4.14.0" />
    <PackageVersion Include="System.CommandLine" Version="2.0.13" />
    <PackageVersion Include="System.Collections.Immutable" Version="10.0.10" />
    <PackageVersion Include="System.Memory" Version="4.6.3" />
    <PackageVersion Include="System.Text.Json" Version="10.0.14" />
    <PackageVersion Include="TextMateSharp" Version="2.0.4" />
    <PackageVersion Include="TextMateSharp.Grammars" Version="2.0.4" />
    <PackageVersion Include="TextMateLib" Version="0.2.1" />
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.2" />
  </ItemGroup>
</Project>
