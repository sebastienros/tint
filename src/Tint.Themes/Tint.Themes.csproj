<Project Sdk="Microsoft.NET.Sdk">
  <!-- Every color theme synced from VS Code (themes/), compiled by the Tint source generator. The item list is
       generated by tools/Tint.Sync. -->
  <Import Project="../Tint/build/Tint.props" />
  <Import Project="VSCodeThemes.props" />
  <PropertyGroup>
    <!-- Directory.Build.props sets TargetFramework for single-target projects; clear it so TargetFrameworks applies. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Tint.Themes</RootNamespace>
    <TintThemesClass>TintThemes</TintThemesClass>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <Description>The color themes of Visual Studio Code, compiled for Tint: one class per theme, TintThemes.All and TintThemes.Find. Trimming keeps only the themes an application uses.</Description>
    <PackageTags>textmate;syntax-highlighting;theme;vscode;tint</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
    <!-- Compares the package's assemblies across target frameworks; a baseline version is added after 0.1.0 ships. -->
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>
  <ItemGroup>
    <!-- Every public change shows in PublicAPI.Unshipped.txt; release moves the entries to PublicAPI.Shipped.txt. -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Tint/Tint.csproj" />
    <!-- In-repo stand-in for the analyzer the Tint package carries; nothing of it reaches this package. -->
    <ProjectReference Include="../Tint.Generator/Tint.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../assets/icon.png" Pack="true" PackagePath="/" />
    <None Include="../../THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="licenses/THIRD-PARTY-NOTICES.txt" />
  </ItemGroup>
</Project>
