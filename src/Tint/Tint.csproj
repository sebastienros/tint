<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Directory.Build.props sets TargetFramework for single-target projects; clear it so TargetFrameworks applies. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <Description>TextMate syntax colorization for .NET: VS Code grammars and themes compiled by a source generator, regexes by GregsEx, NativeAOT and trimming safe.</Description>
    <PackageTags>textmate;syntax-highlighting;tokenizer;colorizer;grammar;vscode</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
    <!-- Compares the package's assemblies across target frameworks; a baseline version is added after 0.1.0 ships. -->
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Meziantou.Polyfill" PrivateAssets="all" />
    <PackageReference Include="System.Collections.Immutable" />
    <PackageReference Include="System.Memory" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>
  <ItemGroup>
    <!-- Every public change shows in PublicAPI.Unshipped.txt; release moves the entries to PublicAPI.Shipped.txt. -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="GregsEx" />
    <!-- Builds the generator first so its assembly can be packed below; nothing is referenced and no package dependency
         is produced. -->
    <ProjectReference Include="../Tint.Generator/Tint.Generator.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <!-- The generator's JSON reader; the runtime reads JSON with System.Text.Json. -->
    <Compile Remove="Loading/JsonTreeReader.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../assets/icon.png" Pack="true" PackagePath="/" />
    <None Include="../../THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="licenses/THIRD-PARTY-NOTICES.txt" />
    <None Include="build/Tint.props" Pack="true" PackagePath="build/Tint.props" />
    <None Include="build/Tint.props" Pack="true" PackagePath="buildTransitive/Tint.props" />
    <None Include="../Tint.Generator/bin/$(Configuration)/netstandard2.0/Tint.Generator.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <InternalsVisibleTo Include="Tint.Tests" />
    <InternalsVisibleTo Include="Tint.Benchmarks" />
  </ItemGroup>
</Project>
