<Project Sdk="Microsoft.NET.Sdk">
  <!-- File-only package: the synced VS Code grammars (../../grammars/) under content/grammars/ with their original layout, and
       build/Tint.Grammars.Sources.props (generated by tools/Tint.Sync) defining $(TintGrammarsSourcesPath) and the
       TintGrammarsSourcesAll items. No assembly; DevelopmentDependency makes a plain reference PrivateAssets="all". -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <DevelopmentDependency>true</DevelopmentDependency>
    <!-- NU5128: no lib/ folder for the target framework, by design. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <Description>The TextMate grammar files of Visual Studio Code (JSON and plist, with their manifest) for the Tint source generator: reference the package, include the grammars you want as TintGrammar items from %24(TintGrammarsSourcesPath), and the generator compiles exactly those into your assembly with your own names, kernels and trimming. Development dependency: nothing ships with your application.</Description>
    <PackageTags>textmate;syntax-highlighting;grammar;vscode;tint;sources</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../assets/icon.png" Pack="true" PackagePath="/" />
    <None Include="../../THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="licenses/THIRD-PARTY-NOTICES.txt" />
    <None Include="build/Tint.Grammars.Sources.props" Pack="true" PackagePath="build/Tint.Grammars.Sources.props" />
    <None Include="build/Tint.Grammars.Sources.props" Pack="true" PackagePath="buildTransitive/Tint.Grammars.Sources.props" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../grammars/**/syntaxes/*" Pack="true" PackagePath="content/grammars/" Visible="false" />
    <None Include="../../grammars/manifest.json" Pack="true" PackagePath="content/grammars/" Visible="false" />
  </ItemGroup>
</Project>
