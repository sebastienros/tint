<Project Sdk="Microsoft.NET.Sdk">
  <!-- File-only package: the synced VS Code themes (../../themes/) under content/themes/ with their original layout, and
       build/Tint.Themes.Sources.props (generated by tools/Tint.Sync) defining $(TintThemesSourcesPath) and the
       TintThemesSourcesAll items. No assembly; DevelopmentDependency makes a plain reference PrivateAssets="all". -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <DevelopmentDependency>true</DevelopmentDependency>
    <!-- NU5128: no lib/ folder for the target framework, by design. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <Description>The color theme files of Visual Studio Code (with their includes and manifest) for the Tint source generator: reference the package, include the themes you want as TintTheme items from %24(TintThemesSourcesPath), and the generator compiles exactly those into your assembly. Development dependency: nothing ships with your application.</Description>
    <PackageTags>textmate;syntax-highlighting;theme;vscode;tint;sources</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../assets/icon.png" Pack="true" PackagePath="/" />
    <None Include="../../THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="licenses/THIRD-PARTY-NOTICES.txt" />
    <None Include="build/Tint.Themes.Sources.props" Pack="true" PackagePath="build/Tint.Themes.Sources.props" />
    <None Include="build/Tint.Themes.Sources.props" Pack="true" PackagePath="buildTransitive/Tint.Themes.Sources.props" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../themes/**/*.json" Exclude="../../themes/**/package.json;../../themes/**/package.nls.json;../../themes/**/cgmanifest.json" Pack="true" PackagePath="content/themes/" Visible="false" />
  </ItemGroup>
</Project>
