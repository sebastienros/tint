<Project Sdk="Microsoft.NET.Sdk">
  <!-- Published with PublishTrimmed and with PublishAot by .github/workflows/aot.yml. It uses three bundled classes only,
       so a trimmed publish must drop every other grammar and theme; run with expect-trimmed to check that. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Tint.TrimSmoke</RootNamespace>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>
  <!-- -p:TintSmoke=trimmed or aot rather than -p:PublishTrimmed/-p:PublishAot: command-line properties reach every
       project restore evaluates, and the netstandard2.0 generator refuses them. -->
  <PropertyGroup Condition="'$(TintSmoke)' == 'trimmed'">
    <PublishTrimmed>true</PublishTrimmed>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TintSmoke)' == 'aot'">
    <PublishAot>true</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Tint.Grammars/Tint.Grammars.csproj" />
    <ProjectReference Include="../../src/Tint.Themes/Tint.Themes.csproj" />
  </ItemGroup>
</Project>
