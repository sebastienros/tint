<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Adds the local feed Tint.Sources.Sample packs before restore; the repository's nuget.config still applies. -->
  <packageSources>
    <add key="TintSources" value="../../artifacts/sources-feed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="TintSources">
      <package pattern="Tint.Grammars.Sources" />
      <package pattern="Tint.Themes.Sources" />
    </packageSource>
  </packageSourceMapping>
</configuration>
