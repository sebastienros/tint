<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="NuGet" value="https://api.nuget.org/v3/index.json" />
    <add key="GregsEx" value="https://f.feedz.io/sebastienros/gregsex/nuget/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="NuGet">
      <package pattern="*" />
    </packageSource>
    <!-- GregsEx previews -->
    <packageSource key="GregsEx">
      <package pattern="GregsEx" />
    </packageSource>
  </packageSourceMapping>
</configuration>
